---
// Fonts are self-hosted (same origin, immutable cache). Only the latin subsets
// are ever downloaded, thanks to unicode-range in the fontsource CSS.
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/kalam/latin-700.css';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import kalamUrl from '@fontsource/kalam/files/kalam-latin-700-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
}

const {
  title,
  description = `${profile.name}, software engineer in ${profile.location}: backend, AI and DevOps. Python and FastAPI at 9D Technologies, Google Summer of Code 2025 at FOSSology, code in official Jenkins releases.`,
  type = 'website',
  published,
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.site,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: '9D Technologies' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Agriculture, Faisalabad' },
  address: { '@type': 'PostalAddress', addressLocality: 'Lahore', addressCountry: 'PK' },
  email: `mailto:${profile.email}`,
  sameAs: profile.socials.filter((s) => s.url.startsWith('http')).map((s) => s.url),
  knowsAbout: ['Backend engineering', 'FastAPI', 'LLM agents', 'RAG', 'Kubernetes', 'CI/CD', 'Jenkins', 'OpenTelemetry', 'Observability', 'Open source'],
  award: ['Google Summer of Code 2025', 'Linux Foundation LiFT Scholar 2025'],
};

const speculation = { prefetch: [{ source: 'list', urls: ['/writing/'] }] };
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#07090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kalamUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@sam_env" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} · Writing`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        var t = null;
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') t = q;
        if (!t) { try { t = localStorage.getItem('theme'); } catch (e) {} }
        if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style>
      .skip {
        position: absolute; left: 16px; top: -60px; z-index: 100;
        background: var(--accent); color: var(--accent-ink); padding: 10px 14px; border-radius: 8px;
      }
      .skip:focus { top: 12px; }
    </style>
  </body>
</html>
