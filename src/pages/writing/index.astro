---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing" description="Posts on backend engineering, Kubernetes, CI/CD, observability and open source by Muhammad Salman.">
  <section class="block wrap page">
    <div class="section-head">
      <span class="eyebrow">writing</span>
      <h1 class="h2">Notes from the debugging trenches.</h1>
      <p class="lede">Long-form write-ups of real problems: what broke, what I tried, and what finally worked. Also available as <a href="/rss.xml">RSS</a>.</p>
    </div>
    <WritingList posts={posts} />
  </section>
</Base>

<style>
  .page { padding-top: clamp(48px, 8vw, 96px); }
  .lede a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
