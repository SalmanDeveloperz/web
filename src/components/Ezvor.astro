---
import { ezvor } from '../data/profile';

const pillars = [
  { name: 'foundations', v: 82 },
  { name: 'dsa', v: 64 },
  { name: 'consistency', v: 71 },
  { name: 'proof', v: 58 },
];
const score = 69;
const R = 52;
const C = 2 * Math.PI * R;
---

<section id="ezvor" class="block">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">03 · main project</span>
      <h2 class="h2">Ezvor</h2>
      <p class="lede">{ezvor.story}</p>
    </div>

    <div class="ez card reveal">
      <div class="ez-copy">
        <p class="ez-tag mono">{ezvor.tagline}</p>
        <ol class="principles">
          {ezvor.principles.map((p, i) => (
            <li>
              <span class="p-n mono">0{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="chips">{ezvor.stack.map((s) => <span class="chip">{s}</span>)}</div>
        <div class="ez-ctas">
          <a class="btn primary" href={ezvor.live} target="_blank" rel="noopener">Open live app ↗</a>
          <a class="btn" href={ezvor.repo} target="_blank" rel="noopener">Read the code</a>
        </div>
      </div>

      <figure class="ez-mock" aria-label="Illustration of the Ezvor readiness report">
        <div class="mock-bar mono"><span>readiness / backend-engineer</span><span class="muted">deterministic · v1</span></div>
        <div class="mock-body">
          <div class="ring">
            <svg viewBox="0 0 128 128" width="128" height="128" aria-hidden="true">
              <circle cx="64" cy="64" r={R} fill="none" stroke="var(--border)" stroke-width="10" />
              <circle class="ring-fg" cx="64" cy="64" r={R} fill="none" stroke="var(--accent)" stroke-width="10" stroke-linecap="round"
                stroke-dasharray={C} stroke-dashoffset={C * (1 - score / 100)} transform="rotate(-90 64 64)" />
            </svg>
            <div class="ring-val"><span>{score}</span><small class="mono">/ 100</small></div>
          </div>
          <div class="pillars">
            {pillars.map((p) => (
              <div class="pl">
                <div class="pl-top mono"><span>{p.name}</span><span>{p.v}</span></div>
                <div class="pl-track"><span style={`width:${p.v}%`}></span></div>
              </div>
            ))}
          </div>
        </div>
        <div class="moves">
          <p class="mono moves-h">highest-impact next moves</p>
          <ul>
            <li><span class="mono imp">+6</span> Solve 4 medium graph problems in the Arena</li>
            <li><span class="mono imp">+4</span> Ship one project with a public deploy</li>
            <li><span class="mono imp">+3</span> Keep a 14-day activity streak</li>
          </ul>
        </div>
        <figcaption class="mono">illustrative · the score is a pure function of judge-verified evidence</figcaption>
      </figure>
    </div>

    <ul class="features">
      {ezvor.features.map((f, i) => (
        <li class="reveal" style={`transition-delay:${i * 50}ms`}>
          <h3>{f.name}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ez { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); padding: clamp(22px, 3.5vw, 40px); position: relative; overflow: hidden; }
  .ez::before { content: ''; position: absolute; width: 520px; height: 520px; right: -160px; top: -200px; background: radial-gradient(closest-side, var(--glow), transparent); pointer-events: none; }
  .ez-tag { font-size: 12.5px; color: var(--accent); }
  .principles { list-style: none; padding: 0; margin: 20px 0 24px; display: grid; gap: 18px; }
  .principles li { display: grid; grid-template-columns: 34px 1fr; gap: 10px; }
  .p-n { font-size: 12px; color: var(--faint); padding-top: 3px; }
  .principles h3 { font-size: 16px; letter-spacing: -0.01em; font-weight: 600; }
  .principles p { color: var(--text-2); font-size: 14.5px; margin-top: 2px; }
  .ez-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  .ez-mock { position: relative; border: 1px solid var(--border-2); border-radius: 12px; background: var(--bg-2); align-self: center; overflow: hidden; }
  .mock-bar { display: flex; justify-content: space-between; gap: 10px; padding: 10px 14px; font-size: 11px; border-bottom: 1px solid var(--border); color: var(--text-2); }
  .mock-body { display: grid; grid-template-columns: 128px 1fr; gap: 20px; align-items: center; padding: 20px; }
  .ring { position: relative; width: 128px; height: 128px; }
  .ring-val { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .ring-val span { font-size: 36px; font-weight: 600; letter-spacing: -0.05em; line-height: 1; }
  .ring-val small { font-size: 10.5px; color: var(--muted); }
  .pillars { display: grid; gap: 12px; }
  .pl-top { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); }
  .pl-track { height: 6px; border-radius: 99px; background: var(--border); margin-top: 5px; overflow: hidden; }
  .pl-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
  .moves { border-top: 1px solid var(--border); padding: 14px 20px 18px; }
  .moves-h { font-size: 11px; color: var(--faint); text-transform: uppercase; letter-spacing: .06em; }
  .moves ul { list-style: none; padding: 0; margin-top: 10px; display: grid; gap: 8px; font-size: 13.5px; color: var(--text-2); }
  .imp { display: inline-block; min-width: 30px; color: var(--green); font-size: 12px; }
  figcaption { font-size: 10.5px; color: var(--faint); padding: 8px 14px; border-top: 1px solid var(--border); }

  .features { list-style: none; padding: 0; margin-top: 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .features li { background: var(--surface); padding: 20px; }
  .features h3 { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .features p { color: var(--muted); font-size: 14px; margin-top: 4px; }

  @media (max-width: 900px) {
    .ez { grid-template-columns: 1fr; }
    .features { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .features { grid-template-columns: 1fr; }
    .mock-body { grid-template-columns: 1fr; justify-items: center; }
    .pillars { width: 100%; }
  }
</style>
