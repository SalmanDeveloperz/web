---
import Mark from './Mark.astro';
import { ezvor } from '../data/profile';

// Interactive demo of the idea behind the Readiness Engine: a pure function of evidence.
// The weights here are illustrative, not Ezvor's production weights.
const pillars = [
  { key: 'foundations', label: 'Foundations', w: 0.25, v: 80, hint: 'CS core topics completed' },
  { key: 'dsa', label: 'DSA', w: 0.35, v: 60, hint: 'judge-accepted problems, by difficulty' },
  { key: 'consistency', label: 'Consistency', w: 0.2, v: 70, hint: 'active days in the last 30' },
  { key: 'proof', label: 'Proof', w: 0.2, v: 55, hint: 'shipped, publicly verifiable work' },
];
const score = Math.round(pillars.reduce((a, p) => a + p.w * p.v, 0));
const R = 52;
const C = +(2 * Math.PI * R).toFixed(2);
---

<section id="ezvor" class="block">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">03 · main project</span>
      <h2 class="h2">Ezvor, the one I’m <Mark variant={3}>proudest</Mark> of</h2>
      <p class="lede">{ezvor.story}</p>
    </div>

    <div class="ez card reveal">
      <div class="ez-copy">
        <p class="ez-tag mono">{ezvor.tagline}</p>
        <ol class="principles">
          {ezvor.principles.map((p, i) => (
            <li>
              <span class="p-n mono">0{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="chips">{ezvor.stack.map((s) => <span class="chip">{s}</span>)}</div>
        <div class="ez-ctas">
          <a class="btn primary" href={ezvor.live} target="_blank" rel="noopener">Open live app ↗</a>
          <a class="btn" href={ezvor.repo} target="_blank" rel="noopener">Read the code</a>
        </div>
      </div>

      <figure class="ez-mock" data-engine data-c={C}>
        <div class="mock-bar mono"><span>readiness(evidence) → score</span><span class="muted">try it</span></div>
        <div class="mock-body">
          <div class="ring" role="img" aria-label="Readiness score" data-ring-label>
            <svg viewBox="0 0 128 128" width="128" height="128" aria-hidden="true">
              <circle cx="64" cy="64" r={R} fill="none" stroke="var(--border)" stroke-width="10" />
              <circle data-ring cx="64" cy="64" r={R} fill="none" stroke="var(--accent)" stroke-width="10" stroke-linecap="round"
                stroke-dasharray={C} stroke-dashoffset={C * (1 - score / 100)} transform="rotate(-90 64 64)" />
            </svg>
            <div class="ring-val"><span data-score>{score}</span><small class="mono">/ 100</small></div>
          </div>
          <div class="pillars">
            {pillars.map((p) => (
              <label class="pl">
                <span class="pl-top mono"><span>{p.label} <em>×{p.w}</em></span><output data-out={p.key}>{p.v}</output></span>
                <input type="range" min="0" max="100" step="1" value={p.v} data-w={p.w} data-key={p.key} aria-describedby={`h-${p.key}`} />
                <span class="pl-hint" id={`h-${p.key}`}>{p.hint}</span>
              </label>
            ))}
          </div>
        </div>
        <div class="moves">
          <p class="mono moves-h">biggest next move</p>
          <p class="move" data-move>Raise DSA by 10 for +3.5 points</p>
        </div>
        <figcaption class="mono">
          <span>same input → same score, every time</span>
          <span data-hash class="hash"></span>
        </figcaption>
      </figure>
    </div>

    <ul class="features">
      {ezvor.features.map((f, i) => (
        <li class="reveal" style={`transition-delay:${i * 50}ms`}>
          <h3>{f.name}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const fig = document.querySelector<HTMLElement>('[data-engine]');
  if (fig) {
    const C = Number(fig.dataset.c);
    const ring = fig.querySelector<SVGCircleElement>('[data-ring]')!;
    const scoreEl = fig.querySelector<HTMLElement>('[data-score]')!;
    const moveEl = fig.querySelector<HTMLElement>('[data-move]')!;
    const hashEl = fig.querySelector<HTMLElement>('[data-hash]')!;
    const inputs = Array.from(fig.querySelectorAll<HTMLInputElement>('input[type=range]'));

    // FNV-1a over the evidence vector: shows the output is a function of the input only.
    const fnv = (s: string) => {
      let h = 0x811c9dc5;
      for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
      return (h >>> 0).toString(16).padStart(8, '0');
    };

    const update = () => {
      let total = 0;
      let best = { key: '', gain: -1, label: '' };
      for (const el of inputs) {
        const v = Number(el.value);
        const w = Number(el.dataset.w);
        total += v * w;
        fig.querySelector<HTMLOutputElement>(`[data-out="${el.dataset.key}"]`)!.value = String(v);
        el.style.setProperty('--p', `${v}%`);
        const gain = Math.min(10, 100 - v) * w;
        if (gain > best.gain) best = { key: el.dataset.key!, gain, label: el.closest('label')!.querySelector('.pl-top span')!.firstChild!.textContent!.trim() };
      }
      const score = Math.round(total);
      scoreEl.textContent = String(score);
      ring.style.strokeDashoffset = String(C * (1 - score / 100));
      moveEl.textContent = best.gain > 0 ? `Raise ${best.label} by 10 for +${best.gain.toFixed(1)} points` : 'Maxed out. Go apply.';
      hashEl.textContent = `evidence#${fnv(inputs.map((i) => i.value).join(','))}`;
    };
    inputs.forEach((i) => i.addEventListener('input', update));
    update();
  }
</script>

<style>
  .ez { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); padding: clamp(22px, 3.5vw, 40px); position: relative; overflow: hidden; }
  .ez::before { content: ''; position: absolute; width: 520px; height: 520px; right: -160px; top: -200px; background: radial-gradient(closest-side, var(--glow), transparent); pointer-events: none; }
  .ez-tag { font-size: 12.5px; color: var(--accent); }
  .principles { list-style: none; padding: 0; margin: 20px 0 24px; display: grid; gap: 18px; }
  .principles li { display: grid; grid-template-columns: 34px 1fr; gap: 10px; }
  .p-n { font-size: 12px; color: var(--muted); padding-top: 3px; }
  .principles h3 { font-size: 16px; letter-spacing: -0.01em; font-weight: 600; }
  .principles p { color: var(--text-2); font-size: 14.5px; margin-top: 2px; }
  .ez-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  .ez-mock { position: relative; border: 1px solid var(--border-2); border-radius: 12px; background: var(--bg-2); align-self: center; overflow: hidden; }
  .mock-bar { display: flex; justify-content: space-between; gap: 10px; padding: 10px 14px; font-size: 11px; border-bottom: 1px solid var(--border); color: var(--text-2); }
  .mock-body { display: grid; grid-template-columns: 128px 1fr; gap: 22px; align-items: center; padding: 20px; }
  .ring { position: relative; width: 128px; height: 128px; }
  [data-ring] { transition: stroke-dashoffset .35s cubic-bezier(.2,.7,.2,1); }
  .ring-val { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .ring-val span { font-size: 38px; font-weight: 600; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .ring-val small { font-size: 10.5px; color: var(--muted); }
  .pillars { display: grid; gap: 12px; }
  .pl { display: grid; gap: 5px; cursor: pointer; }
  .pl-top { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--text-2); }
  .pl-top em { font-style: normal; color: var(--muted); }
  .pl-top output { color: var(--text); font-variant-numeric: tabular-nums; }
  .pl-hint { font-size: 11.5px; color: var(--muted); }
  input[type='range'] {
    --p: 50%;
    -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 99px; outline-offset: 4px;
    background: linear-gradient(90deg, var(--accent) var(--p), var(--border) var(--p));
  }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--text); border: 3px solid var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  input[type='range']::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--text); border: 3px solid var(--accent); }
  .moves { border-top: 1px solid var(--border); padding: 14px 20px 16px; }
  .moves-h { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .move { font-size: 14px; color: var(--green); margin-top: 6px; }
  figcaption { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: 11px; color: var(--muted); padding: 9px 14px; border-top: 1px solid var(--border); }
  .hash { color: var(--violet); }

  .features { list-style: none; padding: 0; margin-top: 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .features li { background: var(--surface); padding: 20px; }
  .features h3 { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .features p { color: var(--muted); font-size: 14px; margin-top: 4px; }

  @media (max-width: 900px) { .ez { grid-template-columns: 1fr; } .features { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) {
    .features { grid-template-columns: 1fr; }
    .mock-body { grid-template-columns: 1fr; justify-items: center; }
    .pillars { width: 100%; }
  }
</style>
