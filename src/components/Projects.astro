---
import Mark from './Mark.astro';
import TailSampler from './TailSampler.astro';
import { projects } from '../data/profile';
const featured = projects.find((p) => p.featured);
const rest = projects.filter((p) => !p.featured);

---

<section id="work" class="block">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">06 · projects</span>
      <h2 class="h2">More things I’ve <Mark variant={2}>built</Mark></h2>
      <p class="lede">Every one of these exists because something broke, or was slow, or lied to me, and I wanted to see why. The first one is running below: move the sliders.</p>
    </div>

    {featured && (
      <article class="feat card reveal" id="pos-otel">
        <div class="f-copy">
          <div class="p-top">
            <span class="p-kind mono">{featured.kind}</span>
            {featured.metric && <span class="p-metric mono">{featured.metric}</span>}
          </div>
          <h3>{featured.name}</h3>
          <p class="p-body">{featured.body}</p>
          {featured.note && <p class="note"><span class="mono">note</span>{featured.note}</p>}
          <div class="chips">{featured.stack.map((s) => <span class="chip">{s}</span>)}</div>
          <div class="f-ctas">
            {featured.repo && <a class="btn primary" href={featured.repo} target="_blank" rel="noopener">View repository ↗</a>}
            {featured.discussion && <a class="btn" href={featured.discussion} target="_blank" rel="noopener">Jenkins community thread</a>}
          </div>
        </div>
        <TailSampler />
      </article>
    )}

    <div class="grid">
      {rest.map((p, i) => (
        <article class="proj card reveal" style={`transition-delay:${(i % 3) * 60}ms`}>
          <div class="p-top">
            <span class="p-kind mono">{p.kind}</span>
            {p.metric && <span class="p-metric mono">{p.metric}</span>}
          </div>
          <h3>{p.name}</h3>
          <p class="p-body">{p.body}</p>
          <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
          <div class="p-links mono">
            {p.repo && <a href={p.repo} target="_blank" rel="noopener">code ↗</a>}
            {p.live && <a href={p.live} target="_blank" rel="noopener">live ↗</a>}
          </div>
        </article>
      ))}
    </div>

    <p class="more reveal">
      <a class="link-arrow" href="https://github.com/SalmanDeveloperz?tab=repositories" target="_blank" rel="noopener">All repositories on GitHub ↗</a>
    </p>
  </div>
</section>

<style>
  .feat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 44px); padding: clamp(22px, 3.5vw, 36px); margin-bottom: 16px; align-items: start; }
  .feat h3 { font-size: 24px; letter-spacing: -0.025em; font-weight: 600; margin-top: 10px; }
  .feat .p-body { margin-top: 10px; }
  .note { display: grid; grid-template-columns: auto 1fr; gap: 10px; margin: 16px 0; padding: 12px 14px; border-radius: 10px; border: 1px dashed var(--border-2); color: var(--text-2); font-size: 14px; background: var(--bg-2); }
  .note .mono { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--amber); padding-top: 3px; }
  .f-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }


  .grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .grid > .proj { grid-column: span 2; }
  .grid > .proj:nth-last-child(-n + 2):nth-child(3n + 1), .grid > .proj:nth-last-child(1):nth-child(3n + 2) { grid-column: span 3; }
  .proj { padding: 22px; display: flex; flex-direction: column; gap: 12px; transition: border-color .2s, transform .2s; }
  .proj:hover { border-color: var(--border-2); transform: translateY(-3px); }
  .p-top { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
  .p-kind { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .p-metric { font-size: 11px; color: var(--green); background: color-mix(in srgb, var(--green) 12%, transparent); padding: 3px 8px; border-radius: 99px; white-space: nowrap; }
  .proj h3 { font-size: 19px; letter-spacing: -0.02em; font-weight: 600; }
  .p-body { color: var(--text-2); font-size: 14.5px; }
  .proj .p-body { flex: 1; }
  .p-links { display: flex; gap: 16px; font-size: 12.5px; }
  .p-links a { color: var(--accent); }
  .p-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .more { margin-top: 28px; }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .grid > .proj { grid-column: auto !important; } .feat { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } }
</style>
