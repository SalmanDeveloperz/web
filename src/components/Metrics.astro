---
import { metrics } from '../data/profile';
---

<section class="wrap metrics-wrap" aria-label="Impact in numbers">
  <ul class="metrics" data-metrics>
    {metrics.map((m, i) => (
      <li class="reveal" style={`transition-delay:${i * 60}ms`}>
        <a href={m.href}>
          <span class="m-value"><span data-n={m.n}>{m.n}</span>{m.suffix}</span>
          <span class="m-label mono">{m.label}</span>
          <span class="m-note">{m.note}</span>
          <span class="m-go mono" aria-hidden="true">proof →</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  // Count up from 0 the first time the row is visible. Server HTML has the real
  // numbers, so no-JS readers and crawlers see them too.
  const row = document.querySelector<HTMLElement>('[data-metrics]');
  if (row && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const els = Array.from(row.querySelectorAll<HTMLElement>('[data-n]'));
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const t0 = performance.now();
      const D = 1100;
      const frame = (t: number) => {
        const k = Math.min(1, (t - t0) / D);
        const ease = 1 - Math.pow(1 - k, 3);
        els.forEach((el) => (el.textContent = String(Math.round(Number(el.dataset.n) * ease))));
        if (k < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }, { threshold: 0.4 });
    io.observe(row);
  }
</script>

<style>
  .metrics-wrap { padding-top: clamp(28px, 4vw, 44px); }
  .metrics { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .metrics li { background: var(--bg); }
  .metrics a { position: relative; height: 100%; padding: 22px 20px; display: flex; flex-direction: column; transition: background .2s; }
  .metrics a:hover { background: var(--surface); }
  .m-value { font-size: clamp(34px, 4vw, 46px); font-weight: 600; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .m-label { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin-top: 8px; }
  .m-note { font-size: 13px; color: var(--muted); margin-top: 8px; line-height: 1.45; }
  .m-go { position: absolute; right: 14px; top: 14px; font-size: 10.5px; color: var(--accent); opacity: 0; transform: translateX(-4px); transition: opacity .2s, transform .2s; }
  .metrics a:hover .m-go, .metrics a:focus-visible .m-go { opacity: 1; transform: none; }
  @media (max-width: 900px) { .metrics { grid-template-columns: repeat(2, 1fr); } .metrics li:last-child { grid-column: 1 / -1; } }
</style>
