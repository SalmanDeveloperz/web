---
import { metrics } from '../data/profile';
---

<section class="wrap metrics-wrap" aria-label="Impact in numbers">
  <dl class="metrics">
    {metrics.map((m, i) => (
      <div class="m reveal" style={`transition-delay:${i * 60}ms`}>
        <dt class="m-label mono">{m.label}</dt>
        <dd class="m-value">{m.value}</dd>
        <dd class="m-note">{m.note}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .metrics-wrap { padding-top: clamp(40px, 6vw, 64px); }
  .metrics { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .m { background: var(--bg); padding: 22px 20px; display: flex; flex-direction: column; }
  .m-label { order: 2; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin-top: 6px; }
  .m-value { order: 1; font-size: clamp(34px, 4vw, 46px); font-weight: 600; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .m-note { order: 3; font-size: 13px; color: var(--muted); margin-top: 8px; line-height: 1.45; }
  @media (max-width: 900px) { .metrics { grid-template-columns: repeat(2, 1fr); } .m:last-child { grid-column: 1 / -1; } }
</style>
