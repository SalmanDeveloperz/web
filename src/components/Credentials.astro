---
import { credentials } from '../data/profile';
---

<div class="wrap">
  <ul class="creds rise" aria-label="Credentials">
    {credentials.map((c) => (
      <li>
        <a href={c.proof} target="_blank" rel="noopener" style={`--brand:${c.color}`}>
          <span class="mark mono" aria-hidden="true">{c.mark}</span>
          <span class="txt">
            <span class="c-label">{c.label}</span>
            <span class="c-title">{c.title}</span>
            <span class="c-detail">{c.detail}</span>
            <span class="c-foot mono"><span>{c.year}</span><span class="proof" aria-hidden="true">proof ↗</span></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .creds { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .creds a {
    position: relative; height: 100%; display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 12px; align-items: start;
    padding: 16px 14px 14px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface);
    overflow: hidden; transition: border-color .2s, transform .2s, background .2s;
  }
  .creds a::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: linear-gradient(90deg, var(--brand), transparent); opacity: .8;
  }
  .creds a:hover { border-color: color-mix(in srgb, var(--brand) 55%, var(--border)); transform: translateY(-2px); background: color-mix(in srgb, var(--brand) 5%, var(--surface)); }
  .mark {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; font-size: 11px; font-weight: 600;
    color: var(--brand); background: color-mix(in srgb, var(--brand) 14%, transparent); border: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
  }
  .txt { display: grid; gap: 3px; min-width: 0; height: 100%; grid-template-rows: auto auto 1fr auto; }
  .c-label { font-size: 12px; color: var(--muted); line-height: 1.3; }
  .c-title { font-size: 15px; font-weight: 600; letter-spacing: -0.015em; color: var(--text); line-height: 1.3; }
  .c-detail { font-size: 12.5px; color: var(--text-2); line-height: 1.45; }
  .c-foot { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--muted); margin-top: 8px; }
  .proof { color: var(--brand); opacity: 0; transform: translateX(-4px); transition: opacity .2s, transform .2s; }
  .creds a:hover .proof, .creds a:focus-visible .proof { opacity: 1; transform: none; }
  @media (max-width: 1080px) { .creds { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .creds { grid-template-columns: 1fr 1fr; } .creds li:last-child:nth-child(odd) { grid-column: 1 / -1; } }
  @media (max-width: 440px) { .creds { grid-template-columns: 1fr; } }
</style>
