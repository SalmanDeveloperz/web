---
import Mark from './Mark.astro';
import { profile } from '../data/profile';
import Icon from './Icon.astro';
const socials = profile.socials.filter((s) => s.url.startsWith('http'));
---

<section id="contact" class="block">
  <div class="wrap">
    <div class="cta card reveal">
      <span class="status">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </span>
      <h2 class="cta-h hand">Say <Mark variant={3}>hello</Mark></h2>
      <p class="lede">Email is the fastest way to reach me. I usually reply within a day ({profile.timezone}).</p>

      <div class="cta-row">
        <a class="btn primary" href={`mailto:${profile.email}?subject=Let%E2%80%99s%20talk`}><Icon name="email" size={16} /> Email me</a>
        <button class="btn mono copy" type="button" data-copy={profile.email} aria-label="Copy email address">
          <span data-copy-label>{profile.email}</span>
          <Icon name="copy" size={14} />
        </button>
        <a class="btn" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" size={16} /> Résumé</a>
      </div>

      <ul class="soc" aria-label="Profiles">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">
              <Icon name={s.name.toLowerCase()} size={15} />
              <span>{s.name}</span>
              <span class="h mono">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const label = b.querySelector<HTMLElement>('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(b.dataset.copy || '');
        if (label) {
          const prev = label.textContent;
          label.textContent = 'copied to clipboard ✓';
          setTimeout(() => (label.textContent = prev), 1400);
        }
      } catch {
        location.href = `mailto:${b.dataset.copy}`;
      }
    }),
  );
</script>

<style>
  .cta { padding: clamp(28px, 6vw, 64px); text-align: center; display: grid; justify-items: center; position: relative; overflow: hidden; }
  .cta::before { content: ''; position: absolute; inset: auto -20% -60% -20%; height: 120%; background: radial-gradient(closest-side, var(--glow), transparent); pointer-events: none; }
  .status {
    position: relative; display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-2);
    padding: 7px 14px 7px 12px; border: 1px solid var(--border-2); border-radius: 999px; background: var(--bg-2);
  }
  .cta-h { font-size: clamp(44px, 6vw, 68px); line-height: 1.05; margin-top: 18px; position: relative; }
  .lede { margin-inline: auto; position: relative; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 28px; position: relative; }
  .copy { font-size: 13px; max-width: 100%; }
  .copy span { overflow: hidden; text-overflow: ellipsis; }
  .soc { position: relative; list-style: none; padding: 0; margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .soc a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); font-size: 13px; color: var(--text-2); transition: border-color .15s, color .15s; }
  .soc a:hover { border-color: var(--accent); color: var(--text); }
  .soc .h { font-size: 11px; color: var(--muted); }
  @media (max-width: 560px) { .soc .h { display: none; } }
</style>
