---
import Mark from './Mark.astro';
import { awards, stack } from '../data/profile';
---

<section id="awards" class="block">
  <div class="wrap split">
    <div>
      <div class="section-head reveal">
        <span class="eyebrow">06 · awards</span>
        <h2 class="h2">Trophy <Mark variant={2}>shelf</Mark></h2>
      </div>
      <ol class="awards">
        {awards.map((a) => (
          <li class="reveal">
            <span class="yr mono">{a.year}</span>
            <div>
              <h3>{a.title}</h3>
              {'badges' in a && a.badges && <div class="badges">{a.badges.map((b) => <span class="medal mono">{b}</span>)}</div>}
              <p>{a.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div id="stack">
      <div class="section-head reveal">
        <span class="eyebrow">07 · skills</span>
        <h2 class="h2">My <Mark variant={3}>toolbox</Mark></h2>
      </div>
      <dl class="stack reveal">
        {stack.map((g) => (
          <div class="row">
            <dt class="mono">{g.group}</dt>
            <dd class="chips">{g.items.map((s) => <span class="chip">{s}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px); }
  .awards { list-style: none; padding: 0; border-top: 1px solid var(--border); }
  .awards li { display: grid; grid-template-columns: 84px 1fr; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .yr { font-size: 12px; color: var(--accent); padding-top: 3px; }
  .awards h3 { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; }
  .awards p { color: var(--muted); font-size: 14.5px; margin-top: 2px; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; margin: 6px 0 4px; }
  .medal { font-size: 11px; padding: 3px 8px; border-radius: 99px; color: var(--amber); border: 1px solid color-mix(in srgb, var(--amber) 45%, transparent); background: color-mix(in srgb, var(--amber) 10%, transparent); }
  .medal:first-child { color: var(--bg); background: var(--amber); border-color: transparent; font-weight: 500; }
  .stack { border-top: 1px solid var(--border); }
  .row { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--border); align-items: start; }
  .row dt { font-size: 12px; color: var(--muted); padding-top: 5px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .row { grid-template-columns: 1fr; gap: 8px; } }
</style>
