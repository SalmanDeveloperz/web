---
import { awards, stack } from '../data/profile';
---

<section id="awards" class="block">
  <div class="wrap split">
    <div>
      <div class="section-head reveal">
        <span class="eyebrow">06 · recognition</span>
        <h2 class="h2">Selected, funded, and ranked.</h2>
      </div>
      <ol class="awards">
        {awards.map((a) => (
          <li class="reveal">
            <span class="yr mono">{a.year}</span>
            <div>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div id="stack">
      <div class="section-head reveal">
        <span class="eyebrow">07 · toolbox</span>
        <h2 class="h2">What I reach for.</h2>
      </div>
      <dl class="stack reveal">
        {stack.map((g) => (
          <div class="row">
            <dt class="mono">{g.group}</dt>
            <dd class="chips">{g.items.map((s) => <span class="chip">{s}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px); }
  .awards { list-style: none; padding: 0; border-top: 1px solid var(--border); }
  .awards li { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .yr { font-size: 12px; color: var(--accent); padding-top: 3px; }
  .awards h3 { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; }
  .awards p { color: var(--muted); font-size: 14.5px; margin-top: 2px; }
  .stack { border-top: 1px solid var(--border); }
  .row { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--border); align-items: start; }
  .row dt { font-size: 12px; color: var(--muted); padding-top: 5px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .row { grid-template-columns: 1fr; gap: 8px; } }
</style>
