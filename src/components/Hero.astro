---
import { profile } from '../data/profile';
import { counts } from '../data/github';
import { build } from '../data/build';
import Icon from './Icon.astro';
import Terminal from './Terminal.astro';

const socials = profile.socials.filter((s) => s.url.startsWith('http'));
const facts = [
  ['Now', 'Backend engineer, 9D Technologies', '#span-9d'],
  ['Upstream', `${counts.merged} merged PRs across ${counts.orgs} orgs`, '#open-source'],
  ['Releases', 'Jenkins 2.565 · LTS 2.568.1 · 2.591', '#oss-jenkins'],
  ['Programs', 'GSoC 2025 · Linux Foundation LiFT', '#changelog'],
  ['Based in', 'Lahore, UTC+5 · open to remote', '#contact'],
];
---

<section class="hero wrap" aria-labelledby="hero-title" data-component="Hero">
  <div class="copy">
    <p class="eyebrow rise">Backend &amp; infrastructure engineer</p>
    <h1 id="hero-title" class="rise">I fix the pipelines <em>nobody</em> wants to touch.</h1>
    <p class="intro rise">{profile.intro[0]}</p>
    <div class="ctas rise">
      <a class="btn primary" href="#work">See the work <Icon name="down" size={16} /></a>
      <a class="btn" href={profile.resume} target="_blank" rel="noopener"><Icon name="file" size={16} /> Résumé</a>
      <ul class="socials" aria-label="Profiles">
        {socials.map((s) => (
          <li><a class="icon-link" href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}><Icon name={s.name.toLowerCase()} size={17} /></a></li>
        ))}
      </ul>
    </div>
    <dl class="facts rise" aria-label="At a glance">
      {facts.map(([k, v, href]) => (
        <div class="fact"><dt>{k}</dt><dd><a href={href}>{v}</a></dd></div>
      ))}
    </dl>
  </div>
  <div class="term-col rise">
    <Terminal build={{ ...build, astro: Astro.generator }} />
  </div>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(40px, 5vw, 80px);
    align-items: center; padding-block: clamp(40px, 7vh, 96px) clamp(56px, 9vh, 112px);
    min-height: min(calc(100svh - 72px), 960px);
  }
  .copy { display: flex; flex-direction: column; }
  h1 {
    font-family: var(--font-display); font-weight: 400; margin-top: 26px;
    font-size: clamp(44px, 5.1vw, 82px); line-height: 1; letter-spacing: -0.025em; text-wrap: balance;
  }
  h1 em { font-style: italic; color: var(--accent); }
  .intro { margin-top: 28px; color: var(--text-2); font-size: clamp(18px, 1.5vw, 20.5px); max-width: 54ch; text-wrap: pretty; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 32px; }
  .socials { list-style: none; padding: 0; display: flex; gap: 2px; margin-left: 4px; }
  .icon-link { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 999px; color: var(--muted); transition: color .15s, background .15s; }
  .icon-link:hover { color: var(--text); background: var(--surface-2); }
  .facts { margin-top: 44px; border-top: 1px solid var(--text); max-width: 520px; }
  .fact { display: grid; grid-template-columns: 108px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 16.5px; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  dd a { transition: color .15s; }
  dd a:hover { color: var(--accent); }
  .term-col { min-width: 0; }

  @media (max-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; padding-top: 48px; }
    .facts { max-width: none; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 32px; gap: 40px; }
    h1 { margin-top: 18px; }
    .fact { grid-template-columns: 92px minmax(0, 1fr); font-size: 15.5px; }
    .socials { margin-left: 0; width: 100%; }
  }
</style>
