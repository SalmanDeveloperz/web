---
import Mark from './Mark.astro';
import { profile, projects, openSource, spans, stack, allPrsUrl } from '../data/profile';
import { counts } from '../data/github';
import Icon from './Icon.astro';

const rows = [
  ['jenkins/docker', 'env-var-subst', 'shipped', 'LTS 2.568.1'],
  ['jenkins/core', 'a11y, kbd-nav', 'merged', 'weekly'],
  ['fossology', `${counts.fossologyCode + counts.fossologyDocs} PRs`, 'merged', 'GSoC 2025'],
  ['owasp/nest', 'a11y, security', 'active', 'collab'],
  ['sktime', 'forecasting', 'review', 'open'],
];

const socials = profile.socials.filter((s) => s.url.startsWith('http'));

// Data the in-browser terminal reads. Kept small and derived from profile.ts.
const termData = {
  email: profile.email,
  resume: profile.resume,
  allPrs: allPrsUrl,
  socials: Object.fromEntries(profile.socials.map((s) => [s.name.toLowerCase(), s.url])),
  experience: [...spans]
    .sort((a, b) => b.start.localeCompare(a.start))
    .filter((s) => s.kind !== 'award')
    .map((s) => `${s.start}  ${s.end ?? 'now    '}  ${s.role} · ${s.org}`),
  projects: [
    'ezvor          career platform, judge-verified readiness score',
    'pdf-scanner    31 in-browser PDF tools (9D Technologies)',
    ...projects.map((p) => `${p.name.split(':')[0].toLowerCase().replace(/\s+/g, '-').slice(0, 14).padEnd(15)}${p.kind.toLowerCase()}`),
  ],
  oss: openSource.map((o) => `${o.name.padEnd(15)}${o.items.length} items${o.highlight ? ` · ${o.highlight}` : ''}`),
  stack: stack.map((g) => `${g.group.padEnd(15)}${g.items.join(', ')}`),
  merged: counts.merged,
};
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="id rise">
      <h1 id="hero-title" class="hand">Hi, I’m <Mark>Salman</Mark>.</h1>
    </div>

    <p class="headline rise">
      I build backend services and fix the <span class="hl">pipelines nobody wants to touch.</span>
    </p>
    <div class="intro rise">{profile.intro.map((p) => <p>{p}</p>)}</div>

    <div class="ctas rise">
      <a class="btn primary" href="#work">
        See the work
        <Icon name="down" size={16} />
      </a>
      <a class="btn" href={profile.resume} target="_blank" rel="noopener">
        <Icon name="file" size={16} /> Résumé
      </a>
      <ul class="socials" aria-label="Profiles">
        {socials.map((s) => (
          <li>
            <a class="icon-link" href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
              <Icon name={s.name.toLowerCase()} size={17} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="term-wrap rise">
  <p class="scribble hand" aria-hidden="true">
    <span>psst, it’s a real terminal. type&nbsp;<b>help</b></span>
    <svg viewBox="0 0 70 60" width="54" height="46"><path d="M8 6 C 40 4, 62 20, 52 50" /><path d="M42 42 L 52 52 L 60 40" /></svg>
  </p>
  <div class="term card" data-term-root>
    <div class="term-bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono term-title">salman@env: ~</span>
      <span class="mono term-meta">interactive · type <b>help</b></span>
    </div>
    <div class="term-body mono" data-term-body tabindex="-1">
      <div data-term-intro>
        <p class="ln"><span class="pr">salman@env:~$</span> <span class="cmd">whoami</span></p>
        <p class="ln out">backend engineer · 9D Technologies · Lahore</p>

        <p class="ln gap"><span class="pr">salman@env:~$</span> <span class="cmd">kubectl get contributions -n open-source</span></p>
        <div class="ln out tbl" role="table" aria-label="Open source contributions">
          <div class="tr th" role="row"><span role="columnheader">NAME</span><span role="columnheader">SCOPE</span><span role="columnheader">STATUS</span><span role="columnheader" class="c4">RELEASE</span></div>
          {rows.map(([n, t, s, r]) => (
            <div class="tr" role="row">
              <span role="cell">{n}</span><span role="cell">{t}</span>
              <span role="cell" class:list={['st', s]}>{s}</span>
              <span role="cell" class="c4">{r}</span>
            </div>
          ))}
        </div>

        <p class="ln gap"><span class="pr">salman@env:~$</span> <span class="cmd">cat impact.json</span></p>
        <pre class="ln out json">{'{'}
  <span class="k">"trace_volume"</span>: <span class="v">"-81%"</span>,
  <span class="k">"build_time"</span>: <span class="v">"-40%"</span>,
  <span class="k">"merged_upstream_prs"</span>: <span class="n">{counts.merged}</span>
{'}'}</pre>
      </div>
      <div data-term-log aria-live="polite"></div>
      <form class="ln gap prompt" data-term-form autocomplete="off">
        <label for="term-input" class="pr">salman@env:~$</label>
        <input id="term-input" data-term-input spellcheck="false" autocapitalize="off" aria-label="Terminal command. Type help for a list." />
      </form>
      <div class="suggest" data-term-suggest>
        {['help', 'projects', 'oss', 'experience', 'contact', 'resume'].map((c) => (
          <button type="button" class="chip" data-cmd={c}>{c}</button>
        ))}
      </div>
    </div>
  </div>
  </div>
</section>

<script is:inline type="application/json" id="term-data" set:html={JSON.stringify(termData)} />

<script>
  const root = document.querySelector<HTMLElement>('[data-term-root]');
  const body = root?.querySelector<HTMLElement>('[data-term-body]');
  const intro = root?.querySelector<HTMLElement>('[data-term-intro]');
  const log = root?.querySelector<HTMLElement>('[data-term-log]');
  const form = root?.querySelector<HTMLFormElement>('[data-term-form]');
  const input = root?.querySelector<HTMLInputElement>('[data-term-input]');
  const data = JSON.parse(document.getElementById('term-data')?.textContent || '{}');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1. Typed intro
  if (intro && !reduce) {
    const lines = Array.from(intro.querySelectorAll<HTMLElement>('.ln'));
    lines.forEach((l) => l.classList.add('pending'));
    form?.classList.add('pending');
    let t = 300;
    for (const l of lines) {
      const cmd = l.querySelector<HTMLElement>('.cmd');
      if (cmd) {
        const full = cmd.textContent || '';
        cmd.textContent = '';
        setTimeout(() => {
          l.classList.remove('pending');
          let i = 0;
          const tick = setInterval(() => {
            cmd.textContent = full.slice(0, ++i);
            if (i >= full.length) clearInterval(tick);
          }, 24);
        }, t);
        t += full.length * 24 + 220;
      } else {
        setTimeout(() => l.classList.remove('pending'), t);
        t += 160;
      }
    }
    setTimeout(() => form?.classList.remove('pending'), t);
  }

  // 2. Interactive shell
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const print = (cmd: string, html: string) => {
    if (!log) return;
    const block = document.createElement('div');
    block.innerHTML = `<p class="ln gap"><span class="pr">salman@env:~$</span> <span class="cmd">${esc(cmd)}</span></p>${html ? `<div class="ln out">${html}</div>` : ''}`;
    log.appendChild(block);
    body?.scrollTo({ top: body.scrollHeight, behavior: reduce ? 'auto' : 'smooth' });
  };
  const list = (rows: string[]) => `<pre class="json">${rows.map(esc).join('\n')}</pre>`;
  const go = (hash: string) => document.querySelector(hash)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });

  const commands: Record<string, { help: string; run: (args: string[]) => string }> = {
    help: {
      help: 'list commands',
      run: () =>
        list(Object.entries(commands).map(([k, v]) => `${k.padEnd(12)}${v.help}`)) +
        `<span class="dim">tab completes, ↑ recalls history</span>`,
    },
    whoami: { help: 'short bio', run: () => 'Muhammad Salman. Backend engineer at 9D Technologies, GSoC 2025 at FOSSology, Jenkins contributor. Lahore, UTC+5.' },
    experience: { help: 'roles, newest first', run: () => (go('#trace'), list(data.experience)) },
    projects: { help: 'what I built', run: () => (go('#ezvor'), list(data.projects)) },
    oss: { help: 'open source summary', run: () => (go('#open-source'), list(data.oss) + `<a href="${data.allPrs}" target="_blank" rel="noopener">all ${data.merged} merged PRs on GitHub ↗</a>`) },
    stack: { help: 'skills by area', run: () => list(data.stack) },
    resume: { help: 'open the PDF', run: () => (window.open(data.resume, '_blank', 'noopener'), 'opening resume.pdf…') },
    contact: {
      help: 'copy my email',
      run: () => {
        navigator.clipboard?.writeText(data.email).catch(() => {});
        return `${esc(data.email)} <span class="ok">copied ✓</span>`;
      },
    },
    open: {
      help: 'open github | linkedin | x | medium',
      run: ([name]) => {
        const url = data.socials[(name || '').toLowerCase()];
        if (!url) return `usage: open ${Object.keys(data.socials).filter((k) => k !== 'email').join(' | ')}`;
        window.open(url, '_blank', 'noopener');
        return `opening ${esc(url)}…`;
      },
    },
    theme: { help: 'toggle light / dark', run: () => (document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click(), 'theme toggled') },
    clear: { help: 'clear the screen', run: () => { if (log) log.innerHTML = ''; intro?.remove(); return ''; } },
    sudo: {
      help: 'try it',
      run: (args) =>
        args.join(' ').startsWith('hire')
          ? (setTimeout(() => (location.href = `mailto:${data.email}?subject=Let%E2%80%99s%20talk`), 600), '<span class="ok">permission granted.</span> opening your mail client…')
          : 'usage: sudo hire salman',
    },
  };
  const aliases: Record<string, string> = { ls: 'projects', email: 'contact', cv: 'resume', exp: 'experience', skills: 'stack', cls: 'clear' };

  const history: string[] = [];
  let hIdx = 0;
  const run = (raw: string) => {
    const line = raw.trim();
    if (!line) return;
    history.push(line);
    hIdx = history.length;
    const [name, ...args] = line.split(/\s+/);
    const key = aliases[name.toLowerCase()] ?? name.toLowerCase();
    const c = commands[key];
    if (key === 'clear') { c.run(args); return; }
    print(line, c ? c.run(args) : `command not found: ${esc(name)}. try <b>help</b>`);
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;
    run(input.value);
    input.value = '';
  });
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && history.length) { e.preventDefault(); hIdx = Math.max(0, hIdx - 1); input.value = history[hIdx]; }
    else if (e.key === 'ArrowDown') { e.preventDefault(); hIdx = Math.min(history.length, hIdx + 1); input.value = history[hIdx] ?? ''; }
    else if (e.key === 'Tab') {
      const v = input.value.trim().toLowerCase();
      const hit = Object.keys(commands).find((k) => v && k.startsWith(v));
      if (hit) { e.preventDefault(); input.value = hit + ' '; }
    }
  });
  root?.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
    b.addEventListener('click', () => { run(b.dataset.cmd || ''); input?.focus({ preventScroll: true }); }),
  );
  body?.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('a,button') && !window.getSelection()?.toString()) input?.focus({ preventScroll: true });
  });
</script>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px);
    align-items: center; padding-block: clamp(36px, 6vh, 72px) clamp(28px, 4vh, 44px);
  }
  h1 { font-size: clamp(44px, 5.2vw, 70px); line-height: 1.05; }
  .term-wrap { position: relative; }
  .scribble { position: absolute; right: 8px; top: -52px; display: flex; align-items: flex-start; gap: 2px; font-size: 19px; color: var(--muted); transform: rotate(-3deg); pointer-events: none; }
  .scribble b { color: var(--accent); }
  .scribble svg { margin-top: 6px; }
  .scribble path { fill: none; stroke: var(--accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .headline { font-size: clamp(20px, 2vw, 25px); line-height: 1.3; letter-spacing: -0.02em; margin-top: 18px; font-weight: 500; max-width: 26ch; text-wrap: balance; }
  .hl { color: var(--accent); }
  .intro { color: var(--text-2); margin-top: 14px; max-width: 58ch; display: grid; gap: 10px; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 22px; }
  .socials { list-style: none; padding: 0; display: flex; gap: 4px; margin-left: 6px; }
  .icon-link { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; color: var(--muted); border: 1px solid transparent; transition: color .15s, border-color .15s, background .15s; }
  .icon-link:hover { color: var(--text); border-color: var(--border-2); background: var(--surface); }

  .term { overflow: hidden; font-size: 12.5px; display: flex; flex-direction: column; }
  .term-bar { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; }
  .lights i:nth-child(1) { background: #ff5f57; } .lights i:nth-child(2) { background: #febc2e; } .lights i:nth-child(3) { background: #28c840; }
  .term-title { font-size: 12px; color: var(--muted); }
  .term-meta { margin-left: auto; font-size: 11px; color: var(--muted); }
  .term-meta b { color: var(--accent); font-weight: 500; }
  .term-body { padding: 14px 18px 16px; line-height: 1.65; height: clamp(320px, 52vh, 420px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .term-body :global(.ln) { transition: opacity .2s; }
  .term-body :global(.ln.pending), .prompt.pending, .prompt.pending + .suggest { opacity: 0; }
  .term-body :global(.gap) { margin-top: 12px; }
  .term-body :global(.pr) { color: var(--accent); white-space: nowrap; }
  .term-body :global(.cmd) { color: var(--text); }
  .term-body :global(.out) { color: var(--text-2); }
  .term-body :global(.dim) { color: var(--muted); }
  .term-body :global(.ok) { color: var(--green); }
  .term-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .term-body :global(.json) { font-family: inherit; margin: 0; white-space: pre; overflow-x: auto; }
  .tbl { display: grid; gap: 1px; margin-top: 4px; overflow-x: auto; }
  .tr { display: grid; grid-template-columns: 1.3fr 1.2fr .8fr 1fr; gap: 10px; white-space: nowrap; }
  .th { color: var(--muted); }
  .st.shipped { color: var(--accent); } .st.merged { color: var(--violet); } .st.active { color: var(--green); } .st.review { color: var(--amber); }
  .k { color: var(--blue); } .v { color: var(--amber); } .n { color: var(--green); }
  .prompt { display: flex; gap: 8px; align-items: center; }
  .prompt input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--text); font: inherit; caret-color: var(--accent); padding: 0; }
  .suggest { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; transition: opacity .3s; }
  .suggest .chip { cursor: pointer; }
  .suggest .chip:hover { border-color: var(--accent); color: var(--accent); }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; }
    .term-wrap { margin-top: 44px; }
    .term-body { height: 380px; }
    .scribble { top: -40px; font-size: 17px; }
  }
  /* Short laptop screens: keep the whole hero above the fold */
  @media (min-width: 981px) and (max-height: 800px) {
    .intro { font-size: 15px; }
    .headline { margin-top: 14px; }
    .term { font-size: 12px; }
  }
  @media (max-width: 560px) {
    .term { font-size: 11px; }
    .term-body { height: 360px; }
    .scribble { right: 0; font-size: 15px; }
    .tr { grid-template-columns: 1.3fr 1.2fr .9fr; }
    .c4, .term-meta { display: none; }
    .socials { margin-left: 0; }
  }
</style>
