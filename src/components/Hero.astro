---
import { profile, credentials } from '../data/profile';

const rows = [
  ['jenkins/docker', 'env-var-subst', 'Shipped', '2.565 · LTS 2.568.1'],
  ['jenkins/core', 'a11y · kbd-nav', 'Merged', 'weekly'],
  ['fossology', '19 PRs', 'Merged', "GSoC '25"],
  ['owasp/nest', 'collaborator', 'Active', "GSoC '26 mentor"],
  ['sktime', 'forecasting', 'Review', '-'],
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <a href="#contact" class="status rise">
      <span class="dot" aria-hidden="true"></span>
      <span>{profile.availability}</span>
    </a>

    <div class="id rise">
      <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="64" height="64" class="avatar" />
      <div>
        <h1 id="hero-title">{profile.name}</h1>
        <p class="role mono">{profile.role} <span class="muted">· {profile.location}</span></p>
      </div>
    </div>

    <p class="headline rise">
      I build backend services and fix the <span class="hl">pipelines nobody wants to touch.</span>
    </p>
    <p class="intro rise">{profile.intro}</p>

    <div class="ctas rise">
      <a class="btn primary" href="#work">
        See the work
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
      </a>
      <a class="btn" href={profile.resume} target="_blank" rel="noopener">Résumé</a>
      <a class="btn" href="https://github.com/SalmanDeveloperz" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
        GitHub
      </a>
      <button class="btn ghost-k" type="button" data-open-palette aria-label="Open command menu"><kbd>⌘K</kbd></button>
    </div>
  </div>

  <div class="term card rise" aria-label="Terminal summary">
    <div class="term-bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono term-title">salman@lahore: ~</span>
      <span class="mono term-meta">zsh · 120×32</span>
    </div>
    <div class="term-body mono" data-term>
      <p class="ln"><span class="pr">salman@lahore:~$</span> <span class="cmd">whoami</span></p>
      <p class="ln out">{profile.name}, backend &amp; infrastructure engineer</p>

      <p class="ln gap"><span class="pr">salman@lahore:~$</span> <span class="cmd">kubectl get contributions -n open-source</span></p>
      <div class="ln out tbl" role="table" aria-label="Open source contributions">
        <div class="tr th" role="row"><span role="columnheader">NAME</span><span role="columnheader">TYPE</span><span role="columnheader">STATUS</span><span role="columnheader" class="c4">RELEASE</span></div>
        {rows.map(([n, t, s, r]) => (
          <div class="tr" role="row">
            <span role="cell">{n}</span><span role="cell">{t}</span>
            <span role="cell" class:list={['st', s.toLowerCase()]}>{s}</span>
            <span role="cell" class="c4">{r}</span>
          </div>
        ))}
      </div>

      <p class="ln gap"><span class="pr">salman@lahore:~$</span> <span class="cmd">curl -s /api/impact | jq</span></p>
      <pre class="ln out json">{'{'}
  <span class="k">"trace_volume"</span>: <span class="v">"-81%"</span>,
  <span class="k">"ci_time"</span>: <span class="v">"-40%"</span>,
  <span class="k">"services_on_k8s"</span>: <span class="v">"10+"</span>,
  <span class="k">"hireable"</span>: <span class="b">true</span>
{'}'}</pre>
      <p class="ln gap"><span class="pr">salman@lahore:~$</span> <span class="cursor" aria-hidden="true"></span></p>
    </div>
  </div>
</section>

<div class="wrap">
  <ul class="creds rise" aria-label="Credentials">
    {credentials.map((c) => (
      <li>
        <span class="c-label">{c.label}</span>
        <span class="c-detail mono">{c.detail}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  const term = document.querySelector<HTMLElement>('[data-term]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (term && !reduce) {
    const lines = Array.from(term.querySelectorAll<HTMLElement>('.ln'));
    lines.forEach((l) => l.classList.add('pending'));
    let t = 350;
    lines.forEach((l) => {
      const cmd = l.querySelector<HTMLElement>('.cmd');
      if (cmd) {
        const full = cmd.textContent || '';
        cmd.textContent = '';
        setTimeout(() => {
          l.classList.remove('pending');
          let i = 0;
          const tick = setInterval(() => {
            cmd.textContent = full.slice(0, ++i);
            if (i >= full.length) clearInterval(tick);
          }, 28);
        }, t);
        t += full.length * 28 + 260;
      } else {
        setTimeout(() => l.classList.remove('pending'), t);
        t += l.classList.contains('tbl') || l.classList.contains('json') ? 220 : 120;
      }
    });
  }
</script>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px);
    align-items: center; padding-block: clamp(48px, 9vw, 104px) clamp(36px, 5vw, 56px);
  }
  .status {
    display: inline-flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-2);
    padding: 7px 14px 7px 12px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
  }
  .status:hover { border-color: var(--border-2); }
  .id { display: flex; align-items: center; gap: 16px; margin-top: 28px; }
  .avatar { width: 64px; height: 64px; border-radius: 16px; object-fit: cover; border: 1px solid var(--border-2); }
  h1 { font-size: clamp(34px, 5vw, 56px); line-height: 1; letter-spacing: -0.045em; font-weight: 700; }
  .role { font-size: 13px; color: var(--accent); margin-top: 8px; }
  .headline { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.25; letter-spacing: -0.025em; margin-top: 28px; font-weight: 500; max-width: 22ch; }
  .hl { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .intro { color: var(--text-2); margin-top: 18px; max-width: 58ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  @media (max-width: 620px) { .ghost-k { display: none; } }
  .ghost-k kbd { font-family: var(--font-mono); font-size: 12px; opacity: 1; color: var(--muted); }

  .term { overflow: hidden; font-size: 12.5px; }
  .term-bar { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: var(--border-2); }
  .lights i:nth-child(1) { background: #ff5f57; } .lights i:nth-child(2) { background: #febc2e; } .lights i:nth-child(3) { background: #28c840; }
  .term-title { font-size: 12px; color: var(--muted); }
  .term-meta { margin-left: auto; font-size: 11px; color: var(--faint); }
  .term-body { padding: 18px 18px 20px; line-height: 1.7; min-height: 420px; }
  .ln { transition: opacity .2s; }
  .ln.pending { opacity: 0; }
  .gap { margin-top: 14px; }
  .pr { color: var(--accent); }
  .cmd { color: var(--text); }
  .out { color: var(--text-2); }
  .tbl { display: grid; gap: 1px; margin-top: 4px; overflow-x: auto; }
  .tr { display: grid; grid-template-columns: 1.25fr 1.2fr .8fr 1.35fr; gap: 10px; white-space: nowrap; }
  .th { color: var(--faint); }
  .st.shipped { color: var(--accent); } .st.merged { color: var(--violet); } .st.active { color: var(--green); } .st.review { color: var(--amber); }
  .json { font-family: inherit; margin: 0; white-space: pre; }
  .k { color: var(--blue); } .v { color: var(--amber); } .b { color: var(--green); }
  .cursor { display: inline-block; width: 8px; height: 15px; background: var(--accent); vertical-align: -3px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .creds { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
  .creds li { padding: 16px 18px; display: grid; gap: 4px; border-right: 1px solid var(--border); }
  .creds li:last-child { border-right: 0; }
  .c-label { font-weight: 600; font-size: 14px; letter-spacing: -0.01em; }
  .c-detail { font-size: 11.5px; color: var(--muted); }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; }
    .term-body { min-height: 0; }
    .creds { grid-template-columns: repeat(2, 1fr); }
    .creds li { border-bottom: 1px solid var(--border); }
    .creds li:nth-child(2n) { border-right: 0; }
    .creds li:last-child { grid-column: 1 / -1; border-bottom: 0; }
  }
  @media (max-width: 560px) {
    .term { font-size: 11px; }
    .tr { grid-template-columns: 1.3fr 1.2fr .9fr; }
    .c4 { display: none; }
  }
</style>
