---
import { profile } from '../data/profile';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { themes } from '../scripts/theme';
const path = Astro.url.pathname;
const home = path === '/';
const links = [
  { href: '/#trace', id: 'trace', label: 'Experience' },
  { href: '/#open-source', id: 'open-source', label: 'Open source' },
  { href: '/#ai', id: 'ai', label: 'AI' },
  { href: '/#ezvor', id: 'ezvor', label: 'Projects' },
  { href: '/writing/', id: 'writing', label: 'Writing' },
];
---

<header class="nav">
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label={`${profile.name}, home`}>
      <Logo />
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Primary" class="links" id="nav-links">
      {links.map((l) => (
        <a href={l.href} data-spy={l.id} class:list={[{ active: !home && path.startsWith(l.href) }]}>{l.label}</a>
      ))}
      <a href="/#contact" class="m-only">Contact</a>
      <a href={profile.resume} class="m-only" target="_blank" rel="noopener">Résumé</a>
    </nav>

    <div class="actions">
      <button class="k-btn mono" type="button" data-open-palette aria-label="Open command menu">
        <span class="k-hint">Search</span><kbd>⌘K</kbd>
      </button>
      <div class="theme-menu" data-theme-menu>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Change theme" aria-haspopup="menu" aria-expanded="false" title="Theme (T)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/></svg>
        </button>
        <div class="tm-pop" role="menu" aria-label="Themes" hidden>
          <p class="tm-h mono">Theme</p>
          {themes.map((t) => (
            <button type="button" role="menuitemradio" class="tm-item" data-set-theme={t.id} aria-checked="false">
              <span class="sw" style={`--a:${t.swatch[0]};--b:${t.swatch[1]}`} aria-hidden="true"></span>
              <span>{t.name}</span>
              <span class="tm-mode mono">{t.mode}</span>
            </button>
          ))}
          <p class="tm-foot mono">press <kbd>T</kbd> to cycle</p>
        </div>
      </div>
      <button class="icon-btn" type="button" data-open-devtools aria-label="Open developer tools" title="Developer tools (Ctrl + `)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></svg>
      </button>
      <a class="btn primary hire" href="/#contact">Contact</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links" data-menu>
        <Icon name="menu" size={18} class="i-open" /><Icon name="close" size={18} class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  import { setTheme, cycleTheme, currentTheme } from '../scripts/theme';

  // Theme menu
  const menu = document.querySelector<HTMLElement>('[data-theme-menu]')!;
  const tBtn = menu.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const pop = menu.querySelector<HTMLElement>('.tm-pop')!;
  const items = Array.from(pop.querySelectorAll<HTMLButtonElement>('[data-set-theme]'));
  const mark = () => items.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.setTheme === currentTheme().id)));
  const openMenu = (open: boolean) => {
    pop.hidden = !open;
    tBtn.setAttribute('aria-expanded', String(open));
    if (open) { mark(); (items.find((b) => b.getAttribute('aria-checked') === 'true') ?? items[0]).focus(); }
  };
  tBtn.addEventListener('click', () => openMenu(pop.hidden));
  items.forEach((b, i) => {
    b.addEventListener('click', () => { setTheme(b.dataset.setTheme!); mark(); openMenu(false); tBtn.focus(); });
    b.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); items[(i + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus(); }
    });
  });
  document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) openMenu(false); });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !pop.hidden) { openMenu(false); tBtn.focus(); }
    const typing = (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]');
    if (!typing && !e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === 't') cycleTheme();
  });
  addEventListener('themechange', mark);

  const nav = document.querySelector<HTMLElement>('.nav')!;
  const bar = nav.querySelector<HTMLElement>('[data-progress]')!;
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const h = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${h > 0 ? Math.min(1, scrollY / h) : 0})`;
      nav.classList.toggle('scrolled', scrollY > 8);
      ticking = false;
    });
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const btn = nav.querySelector<HTMLButtonElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    nav.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
  nav.querySelectorAll('#nav-links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Scroll spy (home page only)
  const spyLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const targets = spyLinks.map((a) => document.getElementById(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          spyLinks.forEach((a) => a.classList.toggle('active', a.dataset.spy === e.target.id));
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    targets.forEach((t) => spy.observe(t));
  }
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid transparent; transition: background .2s ease, border-color .2s ease; }
  .nav.scrolled, .nav.open {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom-color: var(--border);
  }
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
  .nav-inner { height: 72px; display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand-name { font-size: 16px; font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
  .links { display: flex; gap: 4px; margin-left: 12px; }
  .links a { position: relative; font-size: 14px; color: var(--muted); padding: 8px 12px; border-radius: 8px; transition: color .15s, background .15s; }
  .links a:hover { color: var(--text); background: var(--surface); }
  .links a.active { color: var(--text); }
  .links a.active::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 2px; height: 2px; border-radius: 2px; background: var(--accent); }
  .m-only { display: none; }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .k-btn {
    display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 8px 0 12px;
    border: 1px solid var(--border); border-radius: 9px; background: var(--surface); color: var(--muted); font-size: 12px;
  }
  .k-btn:hover { border-color: var(--border-2); color: var(--text); }
  .k-btn kbd { font-family: inherit; font-size: 11px; padding: 3px 6px; border-radius: 5px; background: var(--surface-2); border: 1px solid var(--border); }
  .icon-btn { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); }
  .icon-btn:hover { color: var(--text); border-color: var(--border-2); }
  .theme-menu { position: relative; }
  .tm-pop {
    position: absolute; right: 0; top: calc(100% + 10px); z-index: 60; width: 236px; padding: 8px;
    background: var(--surface); border: 1px solid var(--border-2); border-radius: 14px; box-shadow: 0 24px 60px -24px rgba(0,0,0,.45);
  }
  .tm-h { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding: 6px 8px 8px; }
  .tm-item { width: 100%; display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 10px; padding: 9px 8px; border-radius: 9px; font-size: 14px; text-align: left; }
  .tm-item:hover, .tm-item:focus-visible { background: var(--surface-2); outline: none; }
  .tm-item[aria-checked='true'] { background: var(--accent-soft); }
  .tm-item[aria-checked='true'] .tm-mode { color: var(--accent); }
  .sw { width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--border-2); background: linear-gradient(135deg, var(--a) 50%, var(--b) 50%); }
  .tm-mode { font-size: 11px; color: var(--muted); }
  .tm-foot { font-size: 11px; color: var(--muted); padding: 8px 8px 4px; border-top: 1px solid var(--border); margin-top: 6px; }
  .tm-foot kbd { font-family: inherit; border: 1px solid var(--border-2); border-radius: 4px; padding: 1px 5px; }
  .hire { height: 38px; padding: 0 18px; font-size: 14px; }
  .menu-btn { display: none; }
  .menu-btn :global(.i-close) { display: none; }
  .nav.open .menu-btn :global(.i-open) { display: none; }
  .nav.open .menu-btn :global(.i-close) { display: block; }

  @media (max-width: 900px) {
    .menu-btn { display: grid; }
    .hire { display: none; }
    .links {
      position: absolute; top: 72px; left: 0; right: 0; margin: 0; flex-direction: column; gap: 0;
      padding: 8px var(--gutter) 16px; background: var(--bg); border-bottom: 1px solid var(--border);
      opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .18s, transform .18s, visibility .18s;
    }
    .nav.open .links { opacity: 1; visibility: visible; transform: none; }
    .links a { font-size: 16px; padding: 14px 4px; border-radius: 0; border-bottom: 1px solid var(--border); color: var(--text-2); }
    .links a.active::after { display: none; }
    .m-only { display: block; }
  }
  @media (max-width: 560px) {
    .brand-name, .k-hint { display: none; }
    .nav-inner { gap: 12px; }
  }
</style>
