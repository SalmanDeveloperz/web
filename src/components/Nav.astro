---
import { profile } from '../data/profile';
const path = Astro.url.pathname;
const home = path === '/';
const links = [
  { href: '/#trace', label: 'Experience' },
  { href: '/#open-source', label: 'Open source' },
  { href: '/#work', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label={`${profile.name}, home`}>
      <span class="logo mono" aria-hidden="true">ms<span class="caret">_</span></span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Primary" class="links">
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: !home && l.href !== '/' && path.startsWith(l.href) }]}>{l.label}</a>
      ))}
    </nav>

    <div class="actions">
      <button class="k-btn mono" type="button" data-open-palette aria-label="Open command menu">
        <span class="k-hint">Search</span><kbd>⌘K</kbd>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a class="btn primary hire" href="/#contact">Contact</a>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const d = document.documentElement;
      const next = d.dataset.theme === 'light' ? 'dark' : 'light';
      d.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    }),
  );
  const nav = document.querySelector('.nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    border-bottom: 1px solid transparent;
    transition: background .2s ease, border-color .2s ease, backdrop-filter .2s ease;
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom-color: var(--border);
  }
  .nav-inner { height: 68px; display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.02em; }
  .logo {
    display: flex; align-items: center; justify-content: center; min-width: 38px; padding: 0 6px; height: 34px; border-radius: 9px; white-space: nowrap;
    background: var(--surface); border: 1px solid var(--border-2); font-size: 13px; color: var(--accent);
  }
  .caret { animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .links { display: flex; gap: 4px; margin-left: 12px; }
  .links a { font-size: 14px; color: var(--muted); padding: 8px 12px; border-radius: 8px; transition: color .15s, background .15s; }
  .links a:hover, .links a.active { color: var(--text); background: var(--surface); }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .k-btn {
    display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 8px 0 12px;
    border: 1px solid var(--border); border-radius: 9px; background: var(--surface); color: var(--muted); font-size: 12px;
  }
  .k-btn:hover { border-color: var(--border-2); color: var(--text); }
  .k-btn kbd { font-family: inherit; font-size: 11px; padding: 3px 6px; border-radius: 5px; background: var(--surface-2); border: 1px solid var(--border); }
  .icon-btn { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); }
  .icon-btn:hover { color: var(--text); border-color: var(--border-2); }
  :global(:root[data-theme='light']) .sun { display: none; }
  :global(:root:not([data-theme='light'])) .moon { display: none; }
  .hire { height: 36px; padding: 0 14px; }

  @media (max-width: 900px) { .links { display: none; } }
  @media (max-width: 560px) {
    .brand-name, .k-hint { display: none; }
    .nav-inner { gap: 12px; }
  }
</style>
