---
// The one emphasised word in a heading: serif italic in the accent color.
// `variant` is kept so existing call sites don't need to change.
interface Props { variant?: 1 | 2 | 3 }
---

<em class="mark"><slot /></em>

<style>
  .mark { font-style: italic; color: var(--accent); font-family: var(--font-display); }
  :global(:root[data-theme='phosphor']) .mark { font-style: normal; }
</style>
