---
import { openSource } from '../data/profile';

const statusLabel = { merged: 'merged', shipped: 'shipped', open: 'in review', issue: 'reported', private: 'disclosed' } as const;
---

<section id="open-source" class="block">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">02 · contributions</span>
      <h2 class="h2">Open source</h2>
      <p class="lede">
        Most of these began as bugs I hit myself. I reproduce the bug, write it up, and then send the fix. Some had been open for years. Every row links to its PR or issue.
      </p>
    </div>

    <div class="orgs">
      {openSource.map((o, i) => (
        <article class:list={['org', 'card', 'reveal', { wide: i === 0 || (i === openSource.length - 1 && openSource.length % 2 === 0) }]} id={`oss-${o.slug}`}>
          <header class="org-head">
            <div>
              <h3>{o.name}</h3>
              <p class="org-blurb">{o.blurb}</p>
            </div>
            {o.highlight && <span class="org-hl mono">{o.highlight}</span>}
          </header>
          <ul class="prs">
            {o.items.map((it) => (
              <li>
                <a href={it.url} target="_blank" rel="noopener">
                  <span class={`st ${it.status} mono`}>{statusLabel[it.status]}</span>
                  <span class="pr-title">{it.title}</span>
                  <span class="pr-ref mono">{it.ref}</span>
                </a>
              </li>
            ))}
          </ul>
          {o.all && <a class="link-arrow all" href={o.all} target="_blank" rel="noopener">Full history on GitHub ↗</a>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .orgs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .org { padding: 22px; display: flex; flex-direction: column; }
  .org.wide { grid-column: 1 / -1; }
  .org-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 14px; }
  h3 { font-size: 20px; letter-spacing: -0.02em; font-weight: 600; }
  .org-blurb { color: var(--muted); font-size: 14px; margin-top: 2px; }
  .org-hl { font-size: 11.5px; color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); padding: 6px 10px; border-radius: 999px; white-space: nowrap; }
  .prs { list-style: none; padding: 0; display: grid; }
  .wide .prs { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
  .prs a { display: grid; grid-template-columns: 84px 1fr auto; gap: 12px; align-items: baseline; padding: 10px 0; border-top: 1px solid var(--border); font-size: 14px; }
  .prs a:hover .pr-title { color: var(--accent); }
  .pr-title { color: var(--text-2); transition: color .15s; }
  .pr-ref { font-size: 11.5px; color: var(--faint); white-space: nowrap; }
  .st { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; padding: 3px 7px; border-radius: 5px; text-align: center; border: 1px solid currentColor; line-height: 1.3; }
  .st.shipped { color: var(--accent); background: var(--accent-soft); }
  .st.merged { color: var(--violet); }
  .st.open { color: var(--amber); }
  .st.issue { color: var(--blue); }
  .st.private { color: var(--rose); }
  .all { margin-top: auto; padding-top: 14px; }
  @media (max-width: 860px) {
    .orgs, .wide .prs { grid-template-columns: 1fr; }
    .org-head { flex-direction: column; }
  }
  @media (max-width: 480px) {
    .prs a { grid-template-columns: 1fr; gap: 4px; }
    .st { justify-self: start; }
  }
</style>
